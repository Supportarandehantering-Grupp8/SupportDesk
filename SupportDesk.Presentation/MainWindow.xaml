<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SupportDesk.Presentation.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SupportDesk.Presentation">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="AppNavigation"
        ItemInvoked="AppNavigation_ItemInvoked"
        PaneDisplayMode="Left">

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="HomeNavigationItem"
                Content="Översikt"
                Tag="home"
                Icon="Home" />

            <NavigationViewItem
                x:Name="CustomersNavigationItem"
                Content="Kunder"
                Tag="customers"
                Icon="People" />

            <NavigationViewItem
                x:Name="TicketsNavigationItem"
                Content="Ärenden"
                Tag="tickets"
                Icon="Tag" />
        </NavigationView.MenuItems>

        <Border>
            <ContentControl
                HorizontalContentAlignment="Stretch"
                Content="{x:Bind ViewModel.Navigation.CurrentPage, Mode=OneWay}" />
        </Border>

    </NavigationView>
</Window>