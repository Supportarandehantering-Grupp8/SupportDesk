<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SupportDesk.Presentation.Pages.TicketsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F5F8FC">

    <Grid Padding="32" RowSpacing="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- SIDHUVUD -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Spacing="4">

                <TextBlock
                    Text="Ärenden"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Foreground="#172033"/>

                <TextBlock
                    Text="Sök, filtrera och hantera supportärenden"
                    FontSize="15"
                    Foreground="#64748B"/>

            </StackPanel>


            <Button
                Grid.Column="1"
                Content="Skapa ärende"
                Click="CreateTicketButton_Click"
                Background="#2563EB"
                Foreground="White"
                Padding="22,11"
                MinWidth="145"
                VerticalAlignment="Center"/>

        </Grid>


        <!-- SÖKNING OCH FILTER -->

        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="#DCE4EE"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18">

            <Grid ColumnSpacing="12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- SÖK -->

                <StackPanel
                    Grid.Column="0"
                    Spacing="6">

                    <TextBlock
                        Text="Sök"
                        FontWeight="SemiBold"
                        Foreground="#172033"/>

                    <TextBox
                        x:Name="SearchTextBox"
                        PlaceholderText="Sök efter ärende..."
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>


                <!-- STATUS -->

                <StackPanel
                    Grid.Column="1"
                    Spacing="6">

                    <TextBlock
                        Text="Status"
                        FontWeight="SemiBold"
                        Foreground="#172033"/>

                    <ComboBox
                        x:Name="StatusComboBox"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Alla"
                        SelectionChanged="StatusComboBox_SelectionChanged">

                        <ComboBoxItem Content="Alla"/>
                        <ComboBoxItem Content="New"/>
                        <ComboBoxItem Content="InProgress"/>
                        <ComboBoxItem Content="Resolved"/>

                    </ComboBox>

                </StackPanel>


                <!-- HANDLÄGGARE -->

                <StackPanel
                    Grid.Column="2"
                    Spacing="6">

                    <TextBlock
                        Text="Handläggare"
                        FontWeight="SemiBold"
                        Foreground="#172033"/>

                    <ComboBox
                        x:Name="TechnicianComboBox"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Alla"
                        ItemsSource="{x:Bind ViewModel.Technicians}"
                        SelectionChanged="TechnicianComboBox_SelectionChanged"/>

                </StackPanel>


                <!-- SORTERING -->

                <StackPanel
                    Grid.Column="3"
                    Spacing="6">

                    <TextBlock
                        Text="Sortering"
                        FontWeight="SemiBold"
                        Foreground="#172033"/>

                    <ComboBox
                        x:Name="SortComboBox"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="SortComboBox_SelectionChanged">

                        <ComboBoxItem Content="Nyaste först"/>
                        <ComboBoxItem Content="Äldsta först"/>

                    </ComboBox>

                </StackPanel>


                <!-- RENSA -->

                <Button
                    Grid.Column="4"
                    Content="Rensa filter"
                    VerticalAlignment="Bottom"
                    Padding="18,8"
                    Click="ClearAllFilters_Click"/>

            </Grid>

        </Border>


        <!-- ÄRENDELISTA -->

        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#DCE4EE"
            BorderThickness="1"
            CornerRadius="14"
            Padding="18"
            HorizontalAlignment="Stretch">

            <Grid>

                <ListView
                    ItemsSource="{x:Bind ViewModel.Tickets, Mode=OneWay}"
                    SelectionMode="Single"
                    SelectionChanged="TicketsListView_SelectionChanged">

                    <!-- TABELLHUVUD -->

                    <ListView.Header>

                        <Border
                            Background="#F8FAFC"
                            CornerRadius="8"
                            Padding="4">

                            <Grid
                                ColumnSpacing="12"
                                Padding="12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Text="Kund"
                                    FontWeight="SemiBold"
                                    Foreground="#172033"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="Titel"
                                    FontWeight="SemiBold"
                                    Foreground="#172033"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Datum"
                                    FontWeight="SemiBold"
                                    Foreground="#172033"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="Handläggare"
                                    FontWeight="SemiBold"
                                    Foreground="#172033"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="Prioritet"
                                    FontWeight="SemiBold"
                                    Foreground="#172033"/>

                                <TextBlock
                                    Grid.Column="5"
                                    Text="Status"
                                    FontWeight="SemiBold"
                                    Foreground="#172033"/>

                            </Grid>

                        </Border>

                    </ListView.Header>


                    <!-- LISTRAD -->

                    <ListView.ItemContainerStyle>

                        <Style
                            TargetType="ListViewItem"
                            BasedOn="{StaticResource DefaultListViewItemStyle}">

                            <Setter
                                Property="HorizontalContentAlignment"
                                Value="Stretch"/>

                            <Setter
                                Property="CornerRadius"
                                Value="8"/>

                            <Setter
                                Property="Margin"
                                Value="0,2"/>

                        </Style>

                    </ListView.ItemContainerStyle>


                    <ListView.ItemTemplate>

                        <DataTemplate>

                            <Grid
                                ColumnSpacing="12"
                                Padding="4,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Grid.Column="0"
                                    Tag="{Binding CustomerId}"
                                    Loaded="CustomerName_Loaded"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding CreatedAt}"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="#64748B"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="{Binding Technician}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="{Binding Priority}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Grid.Column="5"
                                    Text="{Binding Status}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </DataTemplate>

                    </ListView.ItemTemplate>

                </ListView>

            </Grid>

        </Border>

    </Grid>

</Page>