<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Pages.TicketDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">

        <ScrollViewer>
            <StackPanel
                Spacing="16"
                MaxWidth="700"
                HorizontalAlignment="Left">

                <Button
                    Content="← Tillbaka till ärenden"
                    Command="{Binding BackCommand}"
                    HorizontalAlignment="Left" />

                <TextBlock
                    Text="Ärendedetaljer"
                    FontSize="28"
                    FontWeight="SemiBold" />

                <TextBlock Text="Titel" />

                <TextBox
                    Text="{Binding Title, Mode=TwoWay}"
                    PlaceholderText="Titel" />

                <TextBlock Text="Beskrivning" />

                <TextBox
                    Text="{Binding Description, Mode=TwoWay}"
                    PlaceholderText="Beskrivning"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="120" />

                <TextBlock Text="Handläggare" />

                <ComboBox
                    ItemsSource="{Binding Technicians}"
                    SelectedItem="{Binding Technician, Mode=TwoWay}"
                    PlaceholderText="Välj handläggare"
                    HorizontalAlignment="Stretch"/>

                <TextBlock Text="Prioritet" />

                <ComboBox
                    ItemsSource="{Binding Priorities}"
                    SelectedItem="{Binding Priority, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

                <TextBlock Text="Status" />

                <ComboBox
                    ItemsSource="{Binding Statuses}"
                    SelectedItem="{Binding Status, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

                <Button
                    Content="Spara ändringar"
                    Command="{Binding SaveTicketCommand}"
                    HorizontalAlignment="Left" />

                <TextBlock
                    x:Name="SaveMessageTextBlock"
                    Text="{Binding SaveMessage}"
                    Foreground="Red"
                    TextWrapping="Wrap"/>

                <TextBlock
                    Text="Kommentarer"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Margin="0,16,0,0" />

                <ListView
                    ItemsSource="{Binding Comments}"
                    MinHeight="150">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6">
                                <TextBlock
                                    Text="{Binding Text}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Text="{Binding CreatedAt}"
                                    FontSize="12"
                                    Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

                <TextBlock Text="Ny kommentar" />

                <TextBox
                    Text="{Binding NewComment, Mode=TwoWay}"
                    PlaceholderText="Skriv en kommentar"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Height="90" />

                <Button
                    Content="Lägg till kommentar"
                    Command="{Binding AddCommentCommand}"
                    HorizontalAlignment="Left" />

            </StackPanel>
        </ScrollViewer>

    </Grid>

</Page>