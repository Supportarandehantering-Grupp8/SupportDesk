<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SupportDesk.Presentation.Pages.CreateTicketPage"
    Loaded="CreateTicketPageLoaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F5F8FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid
            Padding="32"
            RowSpacing="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- SIDHUVUD -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Spacing="4">

                    <TextBlock
                        Text="Skapa ärende"
                        FontSize="32"
                        FontWeight="SemiBold"
                        Foreground="#172033"/>

                    <TextBlock
                        Text="Registrera ett nytt supportärende"
                        FontSize="15"
                        Foreground="#64748B"/>

                </StackPanel>


                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Content="Tillbaka till ärenden"
                    Padding="18,9"
                    VerticalAlignment="Center"/>

            </Grid>


            <!-- FORMULÄR -->

            <Border
                Grid.Row="1"
                Width="600"
                HorizontalAlignment="Left"
                Background="White"
                BorderBrush="#DCE4EE"
                BorderThickness="1"
                CornerRadius="14"
                Padding="28">

                <StackPanel Spacing="18">


                    <!-- KORTRUBRIK -->

                    <StackPanel Spacing="4">

                        <TextBlock
                            Text="Ärendeuppgifter"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                        <TextBlock
                            Text="Fyll i informationen nedan för att skapa ett nytt ärende."
                            FontSize="14"
                            Foreground="#64748B"
                            TextWrapping="Wrap"/>

                    </StackPanel>


                    <!-- TITEL -->

                    <StackPanel Spacing="7">

                        <TextBlock
                            Text="Titel"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                        <TextBox
                            Text="{x:Bind ViewModel.Title, Mode=TwoWay}"
                            GotFocus="Input_GotFocus"
                            PlaceholderText="Ange ärendets titel"/>

                    </StackPanel>


                    <!-- BESKRIVNING -->

                    <StackPanel Spacing="7">

                        <TextBlock
                            Text="Ärendebeskrivning"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                        <TextBox
                            Text="{x:Bind ViewModel.Description, Mode=TwoWay}"
                            GotFocus="Input_GotFocus"
                            PlaceholderText="Beskriv ärendet..."
                            Height="150"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"/>

                    </StackPanel>


                    <!-- KUND -->

                    <StackPanel Spacing="7">

                        <TextBlock
                            Text="Kund"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                        <ComboBox
                            ItemsSource="{x:Bind ViewModel.Customers, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedCustomer, Mode=TwoWay}"
                            DisplayMemberPath="CustomerName"
                            PlaceholderText="Välj en kund"
                            GotFocus="Input_GotFocus"
                            HorizontalAlignment="Stretch"/>

                    </StackPanel>


                    <!-- PRIORITET -->

                    <StackPanel Spacing="7">

                        <TextBlock
                            Text="Prioritet"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="24">

                            <RadioButton
                                Content="Hög"
                                GroupName="Priority"
                                GotFocus="Input_GotFocus"
                                Tag="High"
                                Checked="Priority_Radiobutton_Checked"/>

                            <RadioButton
                                x:Name="Normal_Priority_RadioButton"
                                Content="Normal"
                                GroupName="Priority"
                                GotFocus="Input_GotFocus"
                                Tag="Normal"
                                IsChecked="True"
                                Checked="Priority_Radiobutton_Checked"/>

                            <RadioButton
                                Content="Låg"
                                GroupName="Priority"
                                Tag="Low"
                                GotFocus="Input_GotFocus"
                                Checked="Priority_Radiobutton_Checked"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- MEDDELANDEN -->

                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Foreground="Crimson"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                        Foreground="ForestGreen"
                        TextWrapping="Wrap"/>


                    <!-- SKAPA -->

                    <Button
                        Command="{x:Bind ViewModel.CreateTicketCommand}"
                        Content="Skapa ärende"
                        Background="#2563EB"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="20,11"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>