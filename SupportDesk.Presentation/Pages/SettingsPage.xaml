<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20">

            <!-- Sidans rubrik -->
            <TextBlock
                Text="Inställningar"
                FontSize="26"
                FontWeight="SemiBold"/>

            <!-- Sektion för testdata -->
            <Border
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20"
                MaxWidth="650"
                HorizontalAlignment="Left">

                <StackPanel Spacing="14">

                    <TextBlock
                        Text="Testdata"
                        FontSize="20"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Här kan du återställa applikationens sparade testdata."
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Text="Varning! Alla sparade kunder och ärenden kommer att raderas permanent."
                        Foreground="OrangeRed"
                        TextWrapping="Wrap"/>

                    <Button
                        x:Name="ResetTestDataButton"
                        Content="Återställ testdata"
                        HorizontalAlignment="Left"
                        Padding="20,10"
                        Click="ResetTestDataButton_Click"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</Page>