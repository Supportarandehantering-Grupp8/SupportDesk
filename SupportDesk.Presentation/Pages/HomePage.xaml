<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation.Pages"
    xmlns:vm="using:SupportDesk.Presentation.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="20" Spacing="12">

            <TextBlock
                Text="Översikt"
                FontSize="24"
                FontWeight="SemiBold"/>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    MinHeight="90">

                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Aktiva ärenden"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.ActiveTickets, Mode=OneWay}"
                            FontSize="24"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Avslutade ärenden"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.ResolvedTickets, Mode=OneWay}"
                            FontSize="24"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Totalt antal ärenden"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalTickets, Mode=OneWay}"
                            FontSize="24"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="3"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Kunder"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalCustomers, Mode=OneWay}"
                            FontSize="24"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="4"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                    <StackPanel Spacing="8">
                        <TextBlock
                            Text="Handläggare"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalTechnicians, Mode=OneWay}"
                            FontSize="24"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    HorizontalAlignment="Stretch">

                    <StackPanel Spacing="16">
                        <TextBlock
                            Text="Kunder med aktiva ärenden"
                            FontSize="18"
                            FontWeight="SemiBold"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Kund"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="E-post"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="Aktiva ärenden"
                                FontWeight="SemiBold"/>
                        </Grid>

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.CustomerTicketSummaries, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomerTicketSummary">
                                    <Grid ColumnSpacing="12" Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind CustomerName}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind CustomerEmail}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind TicketCount}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    HorizontalAlignment="Stretch">

                    <StackPanel Spacing="16">
                        <TextBlock
                            Text="Pågående ärenden per handläggare"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Handläggare"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Pågående ärenden"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>
                        </Grid>

                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.TechnicianTicketSummaries, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TechnicianTicketSummary">
                                    <Grid ColumnSpacing="12" Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind TechnicianName}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind InProgressTickets}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16"
                HorizontalAlignment="Stretch">

                <StackPanel Spacing="16">
                    <TextBlock
                        Text="De 5 senaste ärendena"
                        FontSize="18"
                        FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Text="Kund"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="Ärende"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="2"
                            Text="Datum"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="3"
                            Text="Handläggare"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="4"
                            Text="Prioritet"
                            FontWeight="SemiBold"/>

                        <TextBlock
                            Grid.Column="5"
                            Text="Status"
                            FontWeight="SemiBold"/>
                    </Grid>

                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.RecentTickets, Mode=OneWay}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentTicketSummary">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind CustomerName}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind CreatedAt}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind TechnicianName}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{x:Bind Priority}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{x:Bind Status}"
                                        TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
