<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SupportDesk.Presentation.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportDesk.Presentation.Pages"
    xmlns:vm="using:SupportDesk.Presentation.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F5F8FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel
            Padding="32"
            Spacing="20">

            <!-- SIDHUVUD -->

            <StackPanel Spacing="4">
                <TextBlock
                    Text="Översikt"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Foreground="#172033"/>

                <TextBlock
                    Text="En snabb överblick över SupportDesk"
                    FontSize="15"
                    Foreground="#64748B"/>
            </StackPanel>


            <!-- STATISTIK -->

            <Grid ColumnSpacing="14">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- Aktiva -->

                <Border
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="#DCE4EE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20"
                    MinHeight="110">

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Aktiva ärenden"
                            FontSize="14"
                            Foreground="#64748B"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.ActiveTickets, Mode=OneWay}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                    </StackPanel>

                </Border>


                <!-- Avslutade -->

                <Border
                    Grid.Column="1"
                    Background="White"
                    BorderBrush="#DCE4EE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Avslutade ärenden"
                            FontSize="14"
                            Foreground="#64748B"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.ResolvedTickets, Mode=OneWay}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                    </StackPanel>

                </Border>


                <!-- Totalt -->

                <Border
                    Grid.Column="2"
                    Background="White"
                    BorderBrush="#DCE4EE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Totalt antal ärenden"
                            FontSize="14"
                            Foreground="#64748B"
                            TextWrapping="Wrap"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalTickets, Mode=OneWay}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                    </StackPanel>

                </Border>


                <!-- Kunder -->

                <Border
                    Grid.Column="3"
                    Background="White"
                    BorderBrush="#DCE4EE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Kunder"
                            FontSize="14"
                            Foreground="#64748B"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalCustomers, Mode=OneWay}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                    </StackPanel>

                </Border>


                <!-- Handläggare -->

                <Border
                    Grid.Column="4"
                    Background="White"
                    BorderBrush="#DCE4EE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">

                    <StackPanel Spacing="10">

                        <TextBlock
                            Text="Handläggare"
                            FontSize="14"
                            Foreground="#64748B"/>

                        <TextBlock
                            Text="{x:Bind ViewModel.TotalTechnicians, Mode=OneWay}"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- MITTEN -->

            <Grid ColumnSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- KUNDER MED AKTIVA ÄRENDEN -->

                <Border
                    Grid.Column="0"
                    Background="White"
                    BorderBrush="#DCE4EE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    MinHeight="290">

                    <StackPanel Spacing="18">

                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="Kunder med aktiva ärenden"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#172033"/>

                            <TextBlock
                                Text="Kunder som just nu har öppna supportärenden."
                                FontSize="13"
                                Foreground="#64748B"/>

                        </StackPanel>


                        <!-- Rubriker -->

                        <Grid
                            ColumnSpacing="12"
                            Padding="0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Kund"
                                FontWeight="SemiBold"
                                Foreground="#172033"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="E-post"
                                FontWeight="SemiBold"
                                Foreground="#172033"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="Aktiva ärenden"
                                FontWeight="SemiBold"
                                Foreground="#172033"/>

                        </Grid>


                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.CustomerTicketSummaries, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate x:DataType="vm:CustomerTicketSummary">

                                    <Grid
                                        ColumnSpacing="12"
                                        Padding="0,9">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind CustomerName}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind CustomerEmail}"
                                            Foreground="#64748B"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind TicketCount}"
                                            FontWeight="SemiBold"/>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>


                <!-- HANDLÄGGARE -->

                <Border
                    Grid.Column="1"
                    Background="White"
                    BorderBrush="#DCE4EE"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="22"
                    MinHeight="290">

                    <StackPanel Spacing="18">

                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="Pågående ärenden per handläggare"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="#172033"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Fördelning av pågående ärenden."
                                FontSize="13"
                                Foreground="#64748B"/>

                        </StackPanel>


                        <Grid
                            ColumnSpacing="12"
                            Padding="0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="Handläggare"
                                FontWeight="SemiBold"
                                Foreground="#172033"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="Pågående"
                                FontWeight="SemiBold"
                                Foreground="#172033"/>

                        </Grid>


                        <ItemsControl
                            ItemsSource="{x:Bind ViewModel.TechnicianTicketSummaries, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate x:DataType="vm:TechnicianTicketSummary">

                                    <Grid
                                        ColumnSpacing="12"
                                        Padding="0,9">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind TechnicianName}"
                                            TextTrimming="CharacterEllipsis"/>

                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind InProgressTickets}"
                                            FontWeight="SemiBold"/>

                                    </Grid>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- SENASTE ÄRENDEN -->

            <Border
                Background="White"
                BorderBrush="#DCE4EE"
                BorderThickness="1"
                CornerRadius="14"
                Padding="22"
                HorizontalAlignment="Stretch"
                MinHeight="170">

                <StackPanel Spacing="18">

                    <StackPanel Spacing="4">

                        <TextBlock
                            Text="De 5 senaste ärendena"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="#172033"/>

                        <TextBlock
                            Text="Senast registrerade supportärenden."
                            FontSize="13"
                            Foreground="#64748B"/>

                    </StackPanel>


                    <!-- Rubriker -->

                    <Grid
                        ColumnSpacing="12"
                        Padding="0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Kund" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Ärende" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Datum" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="Handläggare" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Prioritet" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="Status" FontWeight="SemiBold"/>

                    </Grid>


                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.RecentTickets, Mode=OneWay}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate x:DataType="vm:RecentTicketSummary">

                                <Grid
                                    ColumnSpacing="12"
                                    Padding="0,9">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Text="{x:Bind CustomerName}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{x:Bind CreatedAt}"
                                        Foreground="#64748B"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{x:Bind TechnicianName}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="4"
                                        Text="{x:Bind Priority}"
                                        TextTrimming="CharacterEllipsis"/>

                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{x:Bind Status}"
                                        TextTrimming="CharacterEllipsis"/>

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</Page>