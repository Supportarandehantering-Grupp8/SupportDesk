<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SupportDesk.Presentation.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">

    <Page.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#F4F7FB"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#172033"/>
        <SolidColorBrush x:Key="SecondaryText" Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    </Page.Resources>

    <Grid Background="{StaticResource PageBackground}"
          Padding="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- RUBRIK -->

        <StackPanel Grid.Row="0"
                    Spacing="6"
                    Margin="0,0,0,25">

            <TextBlock
                Text="Kunder"
                FontSize="30"
                FontWeight="Bold"
                Foreground="{StaticResource PrimaryText}"/>

            <TextBlock
                Text="Hantera och registrera kunder i SupportDesk"
                FontSize="14"
                Foreground="{StaticResource SecondaryText}"/>

        </StackPanel>

        <!-- INNEHÅLL -->

        <Grid Grid.Row="1"
              ColumnSpacing="22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- VÄNSTER: KUNDUPPGIFTER -->

            <Border
                Grid.Column="0"
                Background="{StaticResource CardBackground}"
                CornerRadius="14"
                Padding="24"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

                <StackPanel Spacing="16">

                    <TextBlock
                        Text="Kunduppgifter"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryText}"/>

                    <TextBlock
                        Text="Registrera en ny kund eller välj en kund i listan för att uppdatera."
                        TextWrapping="Wrap"
                        FontSize="13"
                        Foreground="{StaticResource SecondaryText}"/>

                    <!-- NAMN -->

                    <TextBlock
                        Text="Namn"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryText}"
                        Margin="0,12,0,0"/>

                    <TextBox
                        Text="{Binding CustomerName, Mode=TwoWay}"
                        PlaceholderText="Ange kundens namn"
                        Background="#FFFFFF"
                        Foreground="#172033"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Height="44"
                        CornerRadius="8"/>

                    <!-- E-POST -->

                    <TextBlock
                        Text="E-postadress"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryText}"/>

                    <TextBox
                        Text="{Binding CustomerEmail, Mode=TwoWay}"
                        PlaceholderText="exempel@email.se"
                        Background="#FFFFFF"
                        Foreground="#172033"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        Height="44"
                        CornerRadius="8"/>

                    <!-- FELMEDDELANDE -->

                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        Foreground="Crimson"
                        FontSize="13"
                        TextWrapping="Wrap"/>

                    <!-- KNAPPAR -->

                    <Button
                        Content="Skapa kund"
                        Command="{Binding CreateCustomerCommand}"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="44"
                        Margin="0,8,0,0"
                        CornerRadius="8"/>

                    <Button
                        Content="Uppdatera kund"
                        Command="{Binding UpdateCustomerCommand}"
                        Background="#E2E8F0"
                        Foreground="#172033"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Height="44"
                        CornerRadius="8"/>

                </StackPanel>

            </Border>

            <!-- HÖGER: KUNDLISTA -->

            <Border
                Grid.Column="1"
                Background="{StaticResource CardBackground}"
                CornerRadius="14"
                Padding="24"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

                <Grid RowSpacing="18">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Spacing="6">

                        <TextBlock
                            Text="Kundlista"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryText}"/>

                        <TextBlock
                            Text="Välj en kund för att visa eller ändra uppgifterna."
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="{StaticResource SecondaryText}"/>

                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        ItemsSource="{Binding Customers}"
                        SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                        SelectionMode="Single">

                        <ListView.ItemTemplate>

                            <DataTemplate>

                                <Grid Padding="12"
                                      ColumnSpacing="12">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- KUNDIKON -->

                                    <Border
                                        Width="42"
                                        Height="42"
                                        CornerRadius="21"
                                        Background="#DBEAFE">

                                        <FontIcon
                                            Glyph="&#xE77B;"
                                            FontSize="19"
                                            Foreground="#2563EB"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <!-- KUNDINFORMATION -->

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="5"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="{Binding CustomerName}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource PrimaryText}"/>

                                        <TextBlock
                                            Text="{Binding CustomerEmail}"
                                            FontSize="13"
                                            Foreground="{StaticResource SecondaryText}"/>

                                    </StackPanel>

                                </Grid>

                            </DataTemplate>

                        </ListView.ItemTemplate>

                    </ListView>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Page>